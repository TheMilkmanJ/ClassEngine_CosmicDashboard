% --- w = +2, the 21 cm hyperfine frequency ---------------------------------
% Uzan 2011 sources this row and is already cited in the introduction. Its
% Sec. 3.1.1 displays the hydrogen ground-state hyperfine frequency as
%
%     nu ~ c R_inf alpha^2 g_p mubar,     mubar = m_e/m_p,
%
% and R_inf ~ alpha^2 m_e turns that into Eq. (3). Sec. 3.3 states it again as
% nu_hf ~ alpha^2 g_p mu^-1 R_inf in the 21 cm versus UV subsection. Uzan's mu
% is m_p/m_e, the reciprocal of the convention Tzanavaris et al. use; the two
% agree once that is unwound. Verified against the arXiv LaTeX source of
% 1009.5514 on 2026-07-28, not from the abstract.
%
% The two entries below are the observational thread. Both work with
% x = alpha^2 g_p m_e/m_p, which is the hyperfine frequency over an optical
% resonance frequency. Wolfe, Brown and Roberts is the first 21 cm versus
% optical comparison; Tzanavaris et al. is the modern version and defines x
% in its abstract.
@article{WolfeBrownRoberts1976,
  author  = {Wolfe, A. M. and Brown, Robert L. and Roberts, Morton S.},
  title   = {Limits on the Variation of Fundamental Atomic Quantities over
             Cosmic Time Scales},
  journal = {Phys. Rev. Lett.},
  volume  = {37},
  pages   = {179--181},
  year    = {1976},
  doi     = {10.1103/PhysRevLett.37.179}
}

